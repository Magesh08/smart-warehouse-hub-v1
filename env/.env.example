# ═══════════════════════════════════════════════════════════════
#  boulty-v1 — Environment Configuration
#  Copy this file to .env and fill in your actual values.
#  ➜  cp env/.env.example env/.env
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL Database ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=boulty
POSTGRES_PASSWORD=
POSTGRES_DB=boulty_db

# ── Database Connection Pool ────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── pgAdmin ─────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@boulty.local
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050

# ── SSH Tunnel (for remote DB access) ───────────────────────────
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# ── MQTT / PubSub Broker ───────────────────────────────────────
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883

# ── FastAPI Backend ─────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=false
LOG_LEVEL=info

# ── Nginx Reverse Proxy ────────────────────────────────────────
NGINX_PORT=8080
